# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public HTTPS origin used by native builds to reach this backend.
# Set this before running `npm run cap:build`; APP_URL is used as a fallback.
VITE_API_BASE_URL=""

# Comma-separated HTTPS frontend origins when the web app is hosted separately
# from this backend. Capacitor https://localhost and local http://localhost:3000
# are already allowed.
CORS_ALLOWED_ORIGINS=""

# Optional path for the official BTEB results JSON store.
# On Render, set this to a file on an attached persistent disk, e.g.
# /var/data/bteb-results.json. Without it, imports are stored in the
# instance-local data/bteb-results.json file and may be lost on redeploy.
BTEB_RESULTS_STORE_PATH=""

# SYSTEM ADMINISTRATOR PROVISIONING (Optional startup bootstrap)
# To provision the first System Administrator automatically on server startup,
# set INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD in your environment (.env).
# Alternatively, set ADMIN_BOOTSTRAP_TOKEN to use the one-time /api/admin/bootstrap endpoint
# or run `npm run provision-admin -- --email <email> --password <password>`.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
ADMIN_BOOTSTRAP_TOKEN=""

# CAREERJET PARTNER API v4 (Optional automated job feed integration)
# Careerjet requires a registered Partner API v4 key for automated server-to-server queries
# at https://search.api.careerjet.net/v4/query (passed as HTTP Basic Auth username).
# Obtain an API key from https://www.careerjet.com/partners/api
CAREERJET_API_KEY=""
CAREERJET_DEFAULT_AFFID=""

# GITHUB STORE AUTO-BACKUP (Render free tier data survival)
# Render's free instances have an ephemeral filesystem: every deploy or
# restart resets data/academic-store.json to the version committed in GitHub,
# wiping accounts registered and approvals granted at runtime. When this is
# set, the server commits the store file back to the repo (main branch)
# shortly after every change, so the next deploy starts from the latest data.
# Use a fine-grained PAT with Contents read/write on this repo only.
# Without it, the backup is disabled and the server logs a startup warning.
GITHUB_STORE_BACKUP_TOKEN=""
# Optional: how long to wait after a save before backing up (ms). Default 60000.
GITHUB_BACKUP_DEBOUNCE_MS="60000"

# SUPABASE (Postgres + Auth + Storage) — migration in progress (2026-11-23)
# Frontend is on Cloudflare Pages; this backend reads/writes Postgres via
# server/supabaseClient.ts. Values are placeholders only — fill in your own
# from Supabase Dashboard → Settings → API Keys. Never commit a real key.
SUPABASE_URL="https://avqkssnxgquqwlqsipow.supabase.co"
# Publishable key: safe for browser use ONLY after Row Level Security is
# enabled with policies. The app does not use it yet.
SUPABASE_ANON_KEY=""
# Secret (service_role) key: SERVER-ONLY. It bypasses Row Level Security.
# Never put it in a VITE_ variable, never ship it in the APK, never paste
# it in chat, never commit it. The server reads it via getSupabaseClient().
SUPABASE_SERVICE_ROLE_KEY=""

# STUDENT LOGIN REWORK — SMS CODE VERIFICATION (optional, off by default)
# When SMS_VERIFICATION_ENABLED=true, a successful Board Roll + PIN login
# sends a 6-digit code (10-minute expiry, max 3 attempts) to the phone
# number on the account instead of signing the student in directly.
# SMS_PROVIDER selects the sender:
#   "log"  — dev/test only: prints the code to the server console.
#   anything else — generic HTTP JSON provider: POSTs { to, message, sender }
#     to SMS_API_URL with `Authorization: Bearer SMS_API_KEY`.
# If the flag is on but no provider is configured, login FAILS with a
# clear "SMS not configured" error (it never silently skips SMS).
SMS_VERIFICATION_ENABLED="false"
SMS_PROVIDER=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# STUDENT LOGIN REWORK — GOOGLE / FACEBOOK SIGN-IN (optional)
# Server-side verification needs the matching client/app id + secret.
# The sign-in buttons only appear in the app when the VITE_ client ids
# below are set at build time (VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID).
# Social sign-in links by verified email to an EXISTING registered student
# account; students without an account sign in with Board Roll + PIN first.
GOOGLE_CLIENT_ID=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# STUDENT LOGIN REWORK — CLOUDFLARE TURNSTILE CAPTCHA (optional)
# Free at https://dash.cloudflare.com (Turnstile). Set the secret here and
# the matching site key as VITE_TURNSTILE_SITE_KEY at build time. When only
# one side is configured, CAPTCHA is NOT enforced (a warning is logged)
# so a half-configured setup can never lock users out.
TURNSTILE_SECRET_KEY=""

# BUILD-TIME (Vite) — set these before `npm run build` / `npm run cap:build`
# to show the social login buttons and the Turnstile widget in the app.
# VITE_GOOGLE_CLIENT_ID=""
# VITE_FACEBOOK_APP_ID=""
# VITE_TURNSTILE_SITE_KEY=""
