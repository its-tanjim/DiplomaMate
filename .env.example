# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public HTTPS origin used by native builds to reach this backend.
# Set this before running `npm run cap:build`; APP_URL is used as a fallback.
VITE_API_BASE_URL=""

# Comma-separated HTTPS frontend origins when the web app is hosted separately
# from this backend. Capacitor https://localhost and local http://localhost:3000
# are already allowed.
CORS_ALLOWED_ORIGINS=""

# Optional path for the official BTEB results JSON store.
# On Render, set this to a file on an attached persistent disk, e.g.
# /var/data/bteb-results.json. Without it, imports are stored in the
# instance-local data/bteb-results.json file and may be lost on redeploy.
BTEB_RESULTS_STORE_PATH=""

# SYSTEM ADMINISTRATOR PROVISIONING (Optional startup bootstrap)
# To provision the first System Administrator automatically on server startup,
# set INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD in your environment (.env).
# Alternatively, set ADMIN_BOOTSTRAP_TOKEN to use the one-time /api/admin/bootstrap endpoint
# or run `npm run provision-admin -- --email <email> --password <password>`.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
ADMIN_BOOTSTRAP_TOKEN=""

# CAREERJET PARTNER API v4 (Optional automated job feed integration)
# Careerjet requires a registered Partner API v4 key for automated server-to-server queries
# at https://search.api.careerjet.net/v4/query (passed as HTTP Basic Auth username).
# Obtain an API key from https://www.careerjet.com/partners/api
CAREERJET_API_KEY=""
CAREERJET_DEFAULT_AFFID=""
